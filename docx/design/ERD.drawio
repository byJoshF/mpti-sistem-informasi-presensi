        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    USER {\n        BIGINT id PK\n        VARCHAR username UK\n        VARCHAR full_name\n        VARCHAR email UK\n        VARCHAR password\n        VARCHAR role\n        BOOLEAN is_active\n        DATETIME date_joined\n    }\n\n    CLASSROOM {\n        BIGINT id PK\n        BIGINT teacher_id FK\n        VARCHAR name\n        TEXT description\n        VARCHAR join_code UK\n        DATETIME created_at\n    }\n\n    ENROLLMENT {\n        BIGINT id PK\n        BIGINT classroom_id FK\n        BIGINT student_id FK\n        DATETIME joined_at\n        BOOLEAN is_active\n    }\n\n    ATTENDANCESESSION {\n        BIGINT id PK\n        BIGINT classroom_id FK\n        INT meeting_number\n        VARCHAR attendance_code UK\n        SMALLINT duration_minutes\n        DATETIME started_at\n        DATETIME expires_at\n        DATETIME closed_at\n        VARCHAR status\n        TEXT cancellation_reason\n    }\n\n    ATTENDANCERECORD {\n        BIGINT id PK\n        BIGINT session_id FK\n        BIGINT student_id FK\n        VARCHAR status\n        DATETIME submitted_at\n        BIGINT finalized_by_id FK\n        DATETIME finalized_at\n        DATETIME created_at\n    }\n\n    ATTENDANCECHANGELOG {\n        BIGINT id PK\n        BIGINT record_id FK\n        VARCHAR old_status\n        VARCHAR new_status\n        TEXT reason\n        BIGINT changed_by_id FK\n        DATETIME changed_at\n    }\n\n    USER ||--o{ CLASSROOM : teaches\n    USER ||--o{ ENROLLMENT : enrolls\n    CLASSROOM ||--o{ ENROLLMENT : contains\n    CLASSROOM ||--o{ ATTENDANCESESSION : schedules\n    ATTENDANCESESSION ||--o{ ATTENDANCERECORD : records\n    USER ||--o{ ATTENDANCERECORD : attends\n    USER ||--o{ ATTENDANCERECORD : finalizes\n    ATTENDANCERECORD ||--o{ ATTENDANCECHANGELOG : tracks\n    USER ||--o{ ATTENDANCECHANGELOG : changes&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id